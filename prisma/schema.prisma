generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  reviews   Review[]
}

model College {
  id        String   @id @default(uuid())
  name      String
  location  String?
  rating    Float?

  reviews   Review[]
}

model Review {
  id        String  @id @default(cuid())
  comment   String
  rating    Int

  collegeId String
  userId    String

  user      User    @relation(fields: [userId], references: [id])
  college   College @relation(fields: [collegeId], references: [id])

  createdAt DateTime @default(now())
}